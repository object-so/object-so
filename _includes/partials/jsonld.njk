{%- set t = i18n[lang] -%}
{%- set isKo = (lang == "ko") -%}
{%- set canonical = site.baseUrl + "/" + lang + "/" + slug + ".html" -%}
{%- set homeUrl = site.baseUrl + "/" + lang + "/index.html" -%}
{#- Breadcrumb 항목명은 i18n.pageNames[slug]에서 조회한다. slug별 if-체인이었을 때는
    새 페이지를 추가하며 조건을 빠뜨리면 2번 항목이 조용히 "홈"으로 찍혔고,
    check:json-ld가 파싱만 해서 그 버그를 통과시켰다. 이제 누락 시 체커가 실패한다.
    3단계 breadcrumb이 필요한 페이지는 front matter에 `parent: <slug>`를 준다. -#}
{%- set pageName = t.pageNames[slug] or title -%}
{%- set parentName = t.pageNames[parent] -%}
{%- set parentUrl = site.baseUrl + "/" + lang + "/" + parent + ".html" -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.baseUrl }}/#org",
        "name": {% if isKo %}"오브젝트"{% else %}"Object"{% endif %},
        "alternateName": {% if isKo %}"Object"{% else %}"오브젝트"{% endif %},
        "url": "{{ site.baseUrl }}/",
        "sameAs": [{% for u in site.sameAs %}"{{ u }}"{% if not loop.last %}, {% endif %}{% endfor %}],
        "logo": "{{ site.baseUrl }}/assets/img/favicon.svg",
        "image": "{{ site.baseUrl }}{{ site.ogImagePath }}",
        "email": "{{ site.email }}",
        "founder": {
          "@type": "Person",
          "name": {% if isKo %}"진재명"{% else %}"Jaemyeong Jin"{% endif %},
          "alternateName": {% if isKo %}"Jaemyeong Jin"{% else %}"진재명"{% endif %}
        },
        "foundingDate": "2019-11-11",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {% if isKo %}"상리로 86"{% else %}"86 Sangni-ro"{% endif %},
          "addressLocality": {% if isKo %}"북구"{% else %}"Buk-gu"{% endif %},
          "addressRegion": {% if isKo %}"부산광역시"{% else %}"Busan"{% endif %},
          "addressCountry": "KR"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "{{ site.email }}",
          "contactType": "customer support",
          "availableLanguage": ["ko", "en"]
        }
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.baseUrl }}/#website-{{ lang }}",
        "url": "{{ site.baseUrl }}/",
        "name": {% if isKo %}"오브젝트"{% else %}"Object"{% endif %},
        "inLanguage": {% if isKo %}"ko"{% else %}"en"{% endif %},
        "publisher": { "@id": "{{ site.baseUrl }}/#org" }
      }{% if slug != "index" %},
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": {% if isKo %}"홈"{% else %}"Home"{% endif %}, "item": "{{ homeUrl }}" },
{%- if parent %}
          { "@type": "ListItem", "position": 2, "name": {{ parentName | dump | safe }}, "item": "{{ parentUrl }}" },
          { "@type": "ListItem", "position": 3, "name": {{ pageName | dump | safe }}, "item": "{{ canonical }}" }
{%- else %}
          { "@type": "ListItem", "position": 2, "name": {{ pageName | dump | safe }}, "item": "{{ canonical }}" }
{%- endif %}
        ]
      }{% endif %}{% if app %},
      {#- 제품 상세 페이지는 front matter의 `app:` 블록으로 SoftwareApplication을 낸다.
          slug 하드코딩 대신 데이터 유무로 분기해서 제품이 늘어도 이 파일을 안 고친다.
          aggregateRating은 넣지 않는다 — 평가 수가 적어 신뢰도가 낮고, 구글도
          표본이 빈약한 별점 마크업을 권장하지 않는다. -#}
      {
        "@type": "SoftwareApplication",
        "@id": "{{ canonical }}#app",
        "name": {{ app.name | dump | safe }},
        "url": "{{ canonical }}",
        "applicationCategory": {{ app.category | dump | safe }},
        "operatingSystem": {{ app.os | dump | safe }},
        "softwareVersion": {{ app.version | dump | safe }},
        "datePublished": {{ app.published | dump | safe }},
        "inLanguage": [{% for l in app.languages %}"{{ l }}"{% if not loop.last %}, {% endif %}{% endfor %}],
        "publisher": { "@id": "{{ site.baseUrl }}/#org" },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "KRW",
          "availability": "https://schema.org/InStock"
        },
        "sameAs": [{% for u in app.storeUrls %}"{{ u }}"{% if not loop.last %}, {% endif %}{% endfor %}]
      }{% endif %}
    ]
  }
  </script>
