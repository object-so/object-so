{%- set t = i18n[lang] -%}
{%- set canonical = site.baseUrl + "/" + lang + "/" + slug + ".html" -%}
{%- set koUrl = site.baseUrl + "/ko/" + slug + ".html" -%}
{%- set enUrl = site.baseUrl + "/en/" + slug + ".html" %}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title | safe }}</title>
  <meta name="description" content="{{ description | safe }}" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#212529" media="(prefers-color-scheme: dark)" />

  <link rel="canonical" href="{{ canonical }}" />
  <link rel="alternate" hreflang="ko" href="{{ koUrl }}" />
  <link rel="alternate" hreflang="en" href="{{ enUrl }}" />
  <link rel="alternate" hreflang="x-default" href="{{ koUrl }}" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ t.siteName }}" />
  <meta property="og:locale" content="{{ t.locale }}" />
  <meta property="og:locale:alternate" content="{{ t.altLocale }}" />
  <meta property="og:title" content="{{ (ogTitle or title) | safe }}" />
  <meta property="og:description" content="{{ (ogDescription or description) | safe }}" />
  <meta property="og:url" content="{{ canonical }}" />
  <meta property="og:image" content="{{ site.baseUrl }}{{ site.ogImagePath }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

  <link rel="preload" href="/assets/fonts/Pretendard-Regular.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/assets/fonts/Pretendard-ExtraBold.otf" as="font" type="font/otf" crossorigin />

  <link rel="stylesheet" href="/assets/css/tokens.css" />
  <link rel="stylesheet" href="/assets/css/site.css" />
