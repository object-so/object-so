{%- set t = i18n[lang] -%}
{%- set canonical = site.baseUrl + "/" + lang + "/" + slug + ".html" -%}
{%- set koUrl = site.baseUrl + "/ko/" + slug + ".html" -%}
{%- set enUrl = site.baseUrl + "/en/" + slug + ".html" %}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title | escape }}</title>
  <meta name="description" content="{{ description | escape }}" />
  <meta name="theme-color" content="#ffffff" />

  <link rel="canonical" href="{{ canonical }}" />
  <link rel="alternate" hreflang="ko" href="{{ koUrl }}" />
  <link rel="alternate" hreflang="en" href="{{ enUrl }}" />
  <link rel="alternate" hreflang="x-default" href="{{ koUrl }}" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ t.siteName | escape }}" />
  <meta property="og:locale" content="{{ t.locale | escape }}" />
  <meta property="og:locale:alternate" content="{{ t.altLocale | escape }}" />
  <meta property="og:title" content="{{ (ogTitle or title) | escape }}" />
  <meta property="og:description" content="{{ (ogDescription or description) | escape }}" />
  <meta property="og:url" content="{{ canonical }}" />
  <meta property="og:image" content="{{ site.baseUrl }}{{ site.ogImagePath }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ t.ogImageAlt | escape }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ (ogTitle or title) | escape }}" />
  <meta name="twitter:description" content="{{ (ogDescription or description) | escape }}" />
  <meta name="twitter:image" content="{{ site.baseUrl }}{{ site.ogImagePath }}" />
  <meta name="twitter:image:alt" content="{{ t.ogImageAlt | escape }}" />

  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

  <link rel="preload" href="/assets/fonts/PretendardStdVariable.woff2" as="font" type="font/woff2" crossorigin />

  {#- 내용 해시를 붙여 «새 HTML + 옛 CSS» 조합을 원천 차단한다. eleventy.config.js 의 bust 필터 참고.
      폰트는 일부러 제외했다 — tokens.css 의 @font-face 가 같은 파일을 참조하는데 preload 만
      지문이 붙으면 URL 이 어긋나 preload 가 무효가 되고 폰트를 두 번 받는다. -#}
  <link rel="stylesheet" href="{{ '/assets/css/tokens.css' | bust }}" />
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | bust }}" />
